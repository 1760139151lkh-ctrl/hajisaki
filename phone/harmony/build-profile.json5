{
  "app": {
    "signingConfigs": [],
    "products": [{
      "name": "default",
      "compatibleSdkVersion": "26.0.0",
      "targetSdkVersion": "26.0.0",
      "runtimeOS": "HarmonyOS",
      "buildOption": { "strictMode": { "caseSensitiveCheck": true, "useNormalizedOHMUrl": true } }
    }, {
      "name": "openharmony",
      "compatibleSdkVersion": "26.0.0",
      "targetSdkVersion": "26.0.0",
      "compileSdkVersion": "26.0.0",
      "runtimeOS": "OpenHarmony"
    }, {
      "name": "preview",
      "compatibleSdkVersion": "26.0.0",
      "targetSdkVersion": "26.0.0",
      "compileSdkVersion": "26.0.0",
      "runtimeOS": "OpenHarmony"
    }, {
      "name": "legacyDiagnostic",
      "compatibleSdkVersion": 23,
      "targetSdkVersion": 23,
      "compileSdkVersion": 23,
      "runtimeOS": "OpenHarmony"
    }],
    "buildModeSet": [{ "name": "debug" }, { "name": "release" }]
  },
  "modules": [{ "name": "entry", "srcPath": "./entry", "targets": [{ "name": "default", "applyToProducts": ["default", "openharmony", "preview", "legacyDiagnostic"] }] }]
}
